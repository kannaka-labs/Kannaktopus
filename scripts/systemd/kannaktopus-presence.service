[Unit]
Description=Kannaktopus constellation presence beacon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Run as a dedicated unprivileged user. Create it once with:
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin kannaktopus
# The daemon only needs outbound TCP to publish, so root is unnecessary
# privilege.
User=kannaktopus
Group=kannaktopus

# Adjust paths to where Kannaktopus is checked out and your python lives.
WorkingDirectory=/opt/kannaktopus
ExecStart=/usr/bin/env python3 /opt/kannaktopus/scripts/queensync_presence.py
Restart=always
RestartSec=5

# Public NATS bus — override by editing this unit and reloading.
Environment=NATS_URL=nats://swarm.ninja-portal.com:4222
Environment=KANNAKTOPUS_ARM_ID=kannaktopus-01
Environment=KANNAKTOPUS_DISPLAY_NAME=Kannaktopus
Environment=KANNAKTOPUS_PRESENCE_SECONDS=30
# To authenticate as kannaka_internal (required if the bus tightens its
# anon ACL — unauthenticated queen.event.* publishes are dropped silently),
# drop NATS_USER= / NATS_PASSWORD= in /etc/kannaktopus/nats.env and add
# EnvironmentFile=/etc/kannaktopus/nats.env above. Keep that file
# root-owned 0600 and OUT of version control.

# Lock the daemon down — it only needs outbound network.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
